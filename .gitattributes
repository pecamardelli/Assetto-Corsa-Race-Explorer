# Same shared NTFS partition as the parent repo, used from both Windows and
# Linux, so line endings are pinned per file type instead of trusting each
# OS's core.autocrlf. Repo stores LF; checkout is LF everywhere.
* text=auto eol=lf

# Binaries — never touch
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.zip binary
*.7z binary
*.woff binary
*.woff2 binary
